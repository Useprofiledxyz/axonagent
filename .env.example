# Claude API key (console.anthropic.com). Powers the Axon agent.
ANTHROPIC_API_KEY=

# Random secret for sign-in cookies, at least 16 characters.
SESSION_SECRET=

# The ERC-20 token holders need, on Robinhood Chain. Leave TOKEN_ADDRESS empty (or DEMO=1)
# to open the studio to any wallet while testing.
TOKEN_ADDRESS=
TOKEN_SYMBOL=AXON
REQUIRED_AMOUNT=1000000
DEMO=

# Robinhood Chain (defaults shown; change only for another EVM chain).
CHAIN_ID=4663
CHAIN_NAME=Robinhood Chain
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com

# Builds per wallet per day for the first tier (0 = no limit).
DAILY_LIMIT=20
# Higher tiers, as multiples of REQUIRED_AMOUNT (hold) and DAILY_LIMIT (builds).
TIER2_HOLD=5
TIER2_BUILDS=3
TIER3_HOLD=20
TIER3_BUILDS=10

# Optional: a different Claude model.
# AXON_MODEL=claude-opus-5-5
